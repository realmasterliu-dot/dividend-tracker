# 浏览器可公开配置（可进入前端构建产物）
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai
VITE_CLOUDBASE_COLLECTION=user_ledgers
VITE_CLOUDBASE_DATABASE_KIND=document
# PostgreSQL 环境填写控制台显示的实例 ID 与数据库名；文档型数据库留空。
VITE_CLOUDBASE_DATABASE_INSTANCE=
VITE_CLOUDBASE_DATABASE_NAME=
VITE_CLOUDBASE_MEMBERS_TABLE=dividend_members
VITE_CLOUDBASE_REGISTER_FUNCTION=dividend-register
VITE_CLOUDBASE_REGISTER_ENDPOINT=/api/register

# 部署用管理员凭证请只放 GitHub Secrets 或本机安全凭据，绝不能加 VITE_ 前缀：
# TENCENT_ENV_ID=
# TENCENT_CLOUDBASE_API_KEY=

# 可选数据源密钥（仅供 Python 管道 / GitHub Actions 使用）
# TUSHARE_TOKEN=
